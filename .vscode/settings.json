{
  // Hide from Explorer, search and quick-open
  "files.exclude": {
    "**/build": true
  },
  "search.exclude": {
    "**/build": true
  },
  // Stop the C/C++ extension's tag parser indexing these folders,
  // which is where "Find All References" gets its candidates
  "C_Cpp.files.exclude": {
    "**/build": true,
    "**/.vscode": true,
    "**/doc": true
  },
  // Use the up-to-date CMake compile database for IntelliSense
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.arguments": ["--compile-commands-dir=${workspaceFolder}/build"]
}
