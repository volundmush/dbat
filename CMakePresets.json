{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 31, "patch": 0 },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug (GCC, -O0)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_CXX_COMPILER": "g++" }
    },
    {
      "name": "release",
      "displayName": "Release (GCC, -O2 -g)",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "CMAKE_CXX_COMPILER": "g++", "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g" }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer + UBSan (GCC)",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_FLAGS": "-O1 -fsanitize=address,undefined,float-cast-overflow -fno-sanitize-recover=undefined,float-cast-overflow",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined,float-cast-overflow"
      }
    },
    {
      "name": "coverage",
      "displayName": "Line coverage (GCC, gcov): see tools/coverage.sh",
      "binaryDir": "${sourceDir}/build-coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_FLAGS": "--coverage -DDBAT_COVERAGE",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage"
      }
    },
    {
      "name": "fuzz",
      "displayName": "Coverage-guided fuzzing (clang, libFuzzer): see tools/fuzz.py",
      "binaryDir": "${sourceDir}/build-fuzz",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-O1 -fsanitize=fuzzer-no-link,address,undefined,float-cast-overflow -fno-sanitize-recover=undefined,float-cast-overflow -DDBAT_FUZZ",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined,float-cast-overflow",
        "DBAT_FUZZ": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "fuzz", "configurePreset": "fuzz" }
  ]
}
